# Podman Quadlet unit file for Yocto Artifact HTTP Server
# 
# Serves build artifacts at http://localhost:8080/
# 
# Installation:
#   1. Copy to: ~/.config/containers/systemd/artifact-server.container
#   2. Run: systemctl --user daemon-reload
#   3. Confirm generation: ls -la /run/user/$(id -u)/systemd/generator/ | grep artifact
#   4. Run: systemctl --user start artifact-server
#
# Debug:
#   systemctl --user status artifact-server --no-pager
#   journalctl --user -xeu artifact-server --no-pager
#
# If you see: "Error: invalid reference format" (podman exit 125)
# it usually means the generated podman command has tokens in the wrong order.
# Inspect the exact command systemd is running with:
#   systemctl --user show -p ExecStart artifact-server
#
# Access artifacts:
#   http://localhost:8080/dev/stm32mp25-disco/<sha>/images/
#   http://localhost:8080/dev/stm32mp25-disco/latest/images/

[Unit]
Description=Yocto Artifact HTTP Server
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/caddy:2-alpine
ContainerName=artifact-server

# IMPORTANT:
# This file intentionally uses only a minimal set of Quadlet directives that
# are known to work with older/system Podman Quadlet generators.
# Some directives (e.g., Command=, Network=, PublishPort=) may cause the unit
# to be skipped entirely depending on Podman/Quadlet version.

# Serve artifacts on the LAN (bind all interfaces)
# If you want to restrict exposure, change this to your specific LAN IP.
PublishPort=0.0.0.0:8080:80

# Mount artifacts volume (read-only)
Volume=yocto-artifacts:/srv:ro,Z

# Run the caddy container in file-server mode.
# Use Exec= so the command is placed after the image in the generated podman run.
Exec=caddy file-server --root /srv --browse --listen :80

# Labels for identification
Label=app=artifact-server

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=60

[Install]
WantedBy=default.target
