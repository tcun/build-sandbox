# GitHub Actions Self-Hosted Runner for Yocto/KAS Builds
# 
# This image provides a complete build environment for:
# - Yocto Project (Scarthgap) builds via KAS
# - Rust cross-compilation toolchain
# - STM32MP25 BSP development
#
# Usage:
#   podman build -t ghcr.io/backburnerlabs/yocto-runner:latest -f Containerfile .
#   podman run -d \
#     --name yocto-runner \
#     -e RUNNER_PAT=<long-lived-token> \
#     -e RUNNER_REPO=BackburnerLabs/savers-aps \
#     -e RUNNER_NAME=yocto-runner-01 \
#     -e RUNNER_LABELS=yocto,kas,rust \
#     -v yocto-downloads:/cache/downloads:Z \
#     -v yocto-sstate:/cache/sstate-cache:Z \
#     -v yocto-workdir:/home/runner/work:Z \
#     -v yocto-artifacts:/srv/yocto-artifacts:Z \
#     ghcr.io/backburnerlabs/yocto-runner:latest
#
#   Optional fallback (expires quickly):
#     -e RUNNER_TOKEN=<short-lived-runner-registration-token>
#
# Build caches should be mounted to persist across runs and share between runners.

ARG UBUNTU_VERSION=22.04
ARG RUNNER_VERSION=2.321.0
ARG RUST_VERSION=1.91.1

# =============================================================================
# Stage 1: Yocto Build Dependencies Base
# =============================================================================
FROM docker.io/library/ubuntu:${UBUNTU_VERSION} AS base

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install Yocto Project host dependencies (Scarthgap/Kirkstone compatible)
# Reference: https://docs.yoctoproject.org/ref-manual/system-requirements.html
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Essential build tools
    build-essential \
    chrpath \
    cpio \
    debianutils \
    diffstat \
    file \
    gawk \
    gcc \
    g++ \
    git \
    make \
    patch \
    # Python dependencies
    python3 \
    python3-dev \
    python3-distutils \
    python3-git \
    python3-jinja2 \
    python3-pexpect \
    python3-pip \
    python3-subunit \
    python3-venv \
    # Additional Yocto requirements
    bzip2 \
    ca-certificates \
    curl \
    iputils-ping \
    libacl1 \
    liblz4-tool \
    libncurses5-dev \
    libsdl1.2-dev \
    libssl-dev \
    locales \
    lz4 \
    mesa-common-dev \
    rsync \
    socat \
    texinfo \
    unzip \
    wget \
    xterm \
    xz-utils \
    zstd \
    # Git LFS for large file support
    git-lfs \
    # For SDK generation
    xsltproc \
    docbook-utils \
    fop \
    dblatex \
    xmlto \
    # Networking tools (useful for debugging)
    iproute2 \
    net-tools \
    # Compression tools
    pigz \
    pbzip2 \
    # Process management
    procps \
    # Editor (for debugging)
    vim-tiny \
    # sudo for runner operations
    sudo \
    # jq for JSON parsing in scripts
    jq \
    && rm -rf /var/lib/apt/lists/*

# Generate and set locale (required by bitbake)
RUN locale-gen en_US.UTF-8 && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# =============================================================================
# Stage 2: Install Rust Toolchain
# =============================================================================
FROM base AS rust-builder

ARG RUST_VERSION

# Install Rust for the runner user (will be copied later)
ENV RUSTUP_HOME=/opt/rust/rustup
ENV CARGO_HOME=/opt/rust/cargo

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- \
    -y \
    --default-toolchain ${RUST_VERSION} \
    --profile minimal \
    --component rustfmt \
    --component clippy

# Add cross-compilation targets for ARM64 (STM32MP25)
RUN . ${CARGO_HOME}/env && \
    rustup target add aarch64-unknown-linux-gnu && \
    rustup target add aarch64-unknown-linux-musl

# Install commonly needed cargo tools
RUN . ${CARGO_HOME}/env && \
    cargo install cargo-audit cargo-outdated

# =============================================================================
# Stage 3: GitHub Actions Runner
# =============================================================================
FROM base AS runner

ARG RUNNER_VERSION
ARG RUST_VERSION

# Labels for container metadata
LABEL org.opencontainers.image.title="Yocto GitHub Actions Runner"
LABEL org.opencontainers.image.description="Self-hosted GitHub Actions runner for Yocto/KAS builds"
LABEL org.opencontainers.image.vendor="BackburnerLabs"
LABEL org.opencontainers.image.source="https://github.com/BackburnerLabs/savers-aps"
LABEL maintainer="BackburnerLabs"

# Create runner user with specific UID/GID for volume mount compatibility
ARG RUNNER_UID=1000
ARG RUNNER_GID=1000

RUN groupadd --gid ${RUNNER_GID} runner && \
    useradd --uid ${RUNNER_UID} --gid ${RUNNER_GID} --shell /bin/bash --create-home runner && \
    echo "runner ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/runner && \
    chmod 0440 /etc/sudoers.d/runner

# Copy Rust installation from builder stage
COPY --from=rust-builder /opt/rust /opt/rust

# Set up Rust environment for all users
ENV RUSTUP_HOME=/opt/rust/rustup
ENV CARGO_HOME=/opt/rust/cargo
ENV PATH="${CARGO_HOME}/bin:${PATH}"

# Install pipx and KAS build tool
RUN python3 -m pip install --no-cache-dir pipx && \
    pipx ensurepath && \
    PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin pipx install kas

# Install GitHub Actions Runner
WORKDIR /home/runner

RUN mkdir -p /home/runner/actions-runner && \
    cd /home/runner/actions-runner && \
    curl -fsSL -o actions-runner.tar.gz \
        "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz" && \
    tar xzf actions-runner.tar.gz && \
    rm actions-runner.tar.gz && \
    ./bin/installdependencies.sh && \
    chown -R runner:runner /home/runner

# Create cache directories with proper permissions
# These should be mounted as volumes for persistence
RUN mkdir -p /cache/downloads /cache/sstate-cache /home/runner/work && \
    chown -R runner:runner /cache /home/runner/work

# Create artifact storage directory for build outputs
# This should be mounted as a volume: -v yocto-artifacts:/srv/yocto-artifacts:Z
RUN mkdir -p /srv/yocto-artifacts && \
    chown -R runner:runner /srv/yocto-artifacts

# Create the entrypoint script
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

# Create a helper script for manual Yocto builds (useful for debugging)
COPY kas-build.sh /usr/local/bin/kas-build.sh
RUN chmod 755 /usr/local/bin/kas-build.sh

# Switch to runner user
USER runner
WORKDIR /home/runner/actions-runner

# Health check - verify the runner binary exists and is executable
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD [[ -x /home/runner/actions-runner/run.sh ]] && pgrep -f "Runner.Listener" > /dev/null || exit 1

# Set default environment variables for Yocto builds
ENV DL_DIR=/cache/downloads
ENV SSTATE_DIR=/cache/sstate-cache
ENV BB_NUMBER_THREADS=auto
ENV PARALLEL_MAKE="-j auto"

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
