# GitHub Actions Runner Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env with real tokens!

# Preferred (restart-safe): Long-lived GitHub token used to mint runner registration tokens
# - Fine-grained token: grant access to BackburnerLabs/savers-aps and allow Actions self-hosted runners
# - Classic PAT: typically needs `repo` scope (and org-level may need additional privileges)
RUNNER_PAT=

# Optional fallback (expires quickly): GitHub runner registration token
# Generate at: https://github.com/BackburnerLabs/savers-aps/settings/actions/runners/new
RUNNER_TOKEN=

# Optional: Runner identification
RUNNER_REPO=tcun/build-sandbox
RUNNER_NAME=yocto-runner-01
RUNNER_LABELS=yocto,kas,rust,self-hosted,linux,x64
RUNNER_GROUP=Default

# Persistent runner behavior (recommended for non-autoscaled runners):
# - false: reuse existing local runner registration on restart
# - true: force re-registration on every start
RUNNER_RECONFIGURE=false

# Remove runner registration on container stop (usually false for persistent hosts)
RUNNER_REMOVE_ON_EXIT=false

# Canonical Yocto fetch key inside container (compose mounts ./keys at /run/yocto-ssh)
YOCTO_FETCH_SSH_KEY=/run/yocto-ssh/yocto_ci

# Optional: choose image target from Containerfile
# runner-core | runner-yocto | runner-rust | runner-yocto-rust | runner
RUNNER_TARGET=runner

# Image/build config (single place for runner stack versions)
RUNNER_IMAGE=localhost/yocto-runner:latest
RUNNER_CONTAINER_NAME=yocto-runner
RUNNER_HOSTNAME=yocto-runner-01
UBUNTU_VERSION=22.04
RUNNER_VERSION=2.332.0
# Keep this aligned with apps/rust-toolchain.toml
RUST_VERSION=1.94.0
KAS_VERSION=4.8

# Optional: install extra cargo tools into the image (slower builds, may require newer rust)
INSTALL_RUST_TOOLS=false
